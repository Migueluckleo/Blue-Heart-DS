{"schema_version": 1, "status": "PASS", "mode": "graph", "reason": null, "snapshot": "d8efb5d6ab3ef6c9b77ab0b2cb565ddd3f800fa564f17d0dbcefb41a098c99ac", "nodes": [{"id": "specs/components/buttons.contract.v1.0.0.md", "source": "specs/components/buttons.contract.v1.0.0.md", "location": "L1", "version": "1.0.0", "document_status": "DELEGATED_FOR_BUILD", "evidence": "EXTRACTED", "confidence": 1, "sections": []}, {"id": "specs/components/buttons.usage.amendment.v1.0.1.md", "source": "specs/components/buttons.usage.amendment.v1.0.1.md", "location": "L1", "version": "1.0.1", "document_status": "DELEGATED_FOR_BUILD", "evidence": "EXTRACTED", "confidence": 1, "sections": []}, {"id": "specs/components/loader.contract.v1.0.0.md", "source": "specs/components/loader.contract.v1.0.0.md", "location": "L1", "version": "1.0.0", "document_status": "DELEGATED_FOR_BUILD", "evidence": "EXTRACTED", "confidence": 1, "sections": []}, {"id": "specs/foundations/blueheart-variables.contract.v0.1.2.md", "source": "specs/foundations/blueheart-variables.contract.v0.1.2.md", "location": "L1", "version": "0.1.2", "document_status": "DELEGATED_FOR_BUILD", "evidence": "EXTRACTED", "confidence": 1, "sections": []}, {"id": "specs/data/buttons.v1.0.0.json", "source": "specs/data/buttons.v1.0.0.json", "location": "L1", "version": null, "document_status": "UNRESOLVED", "evidence": "EXTRACTED", "confidence": 1, "sections": []}, {"id": "specs/tokens/blueheart-variables.v0.1.2.json", "source": "specs/tokens/blueheart-variables.v0.1.2.json", "location": "L1", "version": null, "document_status": "UNRESOLVED", "evidence": "EXTRACTED", "confidence": 1, "sections": []}, {"id": "specs/tokens/component-layer.correction.json", "source": "specs/tokens/component-layer.correction.json", "location": "L1", "version": null, "document_status": "UNRESOLVED", "evidence": "EXTRACTED", "confidence": 1, "sections": []}, {"id": "specs/tokens/visibility.body-only.correction.json", "source": "specs/tokens/visibility.body-only.correction.json", "location": "L1", "version": null, "document_status": "UNRESOLVED", "evidence": "EXTRACTED", "confidence": 1, "sections": []}], "relations": [{"confidence": 1, "evidence": "EXTRACTED", "line": 22, "relation": "references", "source": "specs/components/buttons.contract.v1.0.0.md", "target": "specs/components/loader.contract.v1.0.0.md"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 32, "relation": "references", "source": "specs/components/buttons.contract.v1.0.0.md", "target": "specs/components/loader.contract.v1.0.0.md"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 17, "relation": "references", "source": "specs/components/buttons.contract.v1.0.0.md", "target": "specs/data/buttons.v1.0.0.json"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 20, "relation": "references", "source": "specs/components/buttons.contract.v1.0.0.md", "target": "specs/data/buttons.v1.0.0.json"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 27, "relation": "references", "source": "specs/components/buttons.contract.v1.0.0.md", "target": "specs/data/buttons.v1.0.0.json"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 22, "relation": "references", "source": "specs/components/buttons.contract.v1.0.0.md", "target": "specs/foundations/blueheart-variables.contract.v0.1.2.md"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 27, "relation": "references", "source": "specs/components/buttons.contract.v1.0.0.md", "target": "specs/foundations/blueheart-variables.contract.v0.1.2.md"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 8, "relation": "references", "source": "specs/components/buttons.usage.amendment.v1.0.1.md", "target": "specs/components/buttons.contract.v1.0.0.md"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 16, "relation": "references", "source": "specs/components/buttons.usage.amendment.v1.0.1.md", "target": "specs/components/buttons.contract.v1.0.0.md"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 11, "relation": "references", "source": "specs/foundations/blueheart-variables.contract.v0.1.2.md", "target": "specs/tokens/blueheart-variables.v0.1.2.json"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 15, "relation": "references", "source": "specs/foundations/blueheart-variables.contract.v0.1.2.md", "target": "specs/tokens/blueheart-variables.v0.1.2.json"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 27, "relation": "references", "source": "specs/foundations/blueheart-variables.contract.v0.1.2.md", "target": "specs/tokens/blueheart-variables.v0.1.2.json"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 95, "relation": "references", "source": "specs/foundations/blueheart-variables.contract.v0.1.2.md", "target": "specs/tokens/component-layer.correction.json"}, {"confidence": 1, "evidence": "EXTRACTED", "line": 14, "relation": "references", "source": "specs/foundations/blueheart-variables.contract.v0.1.2.md", "target": "specs/tokens/visibility.body-only.correction.json"}], "documents": [{"path": "specs/components/buttons.contract.v1.0.0.md", "sha256": "f10c3428203f6d083bfa1a67175609ad3890e6ee8826e9121175159cec909b70", "text": "---\ncontract_schema: sdd-project/0.2\ncontract_id: BUTTON-001\nname: Buttons\ntype: component\nstatus: DELEGATED_FOR_BUILD\nversion: 1.0.0\nlast_updated: 2026-11-11\nfigma_page_name: Buttons\ntarget_file_key: yZsIpXywybsPDytjolwcP4\nfigma_page_id: \"22:3\"\ntarget_node_ids: [\"23:1306\", \"23:1185\", \"23:835\", \"23:952\", \"23:1070\"]\nslot_applicability: NOT_APPLICABLE\nreadiness_by_target: {figma: READY, web: READY}\nuser_audit: NOT_REQUIRED\nhuman_review_policy: OPTIONAL_NON_BLOCKING\nsource_data_ref: specs/data/buttons.v1.0.0.json\nsource_data_digest_sha256: d271e1de91be664fe0c78eef8ea311fdafa52073535f4349a7d78f7611d4c9fa\ndata_refs:\n  - specs/data/buttons.v1.0.0.json\n  - sources/figma-snapshots/buttons-loader-2026-11-11/manifest.json\ndependencies: ['FOUNDATIONS-BLUEHEART-VARIABLES-001', 'LOADER-001']\n---\n\n# Buttons · BUTTON-001\n\nIngesta del [Figma raíz](../../sources/figma-snapshots/buttons-loader-2026-11-11/manifest.json) y recetario delegado de [bindings, geometría y reacciones](../data/buttons.v1.0.0.json). La implementación usa el mapa verificado de [variables del maestro](../foundations/blueheart-variables.contract.v0.1.2.md). La captura registra versiones de origen y hashes. Construcción en la página Buttons, reservada a los principales y sus variantes. P-SLOTS: `NOT_APPLICABLE` por composición acotada.\n\n## Cobertura y comportamiento\n\n- Cinco sets de 18 variantes, tres tamaños (48, 40, 32 px) y seis estados observados. Conserva HUG horizontal, radio, padding, tipografía, subrayado Link, iconos y foco exterior observados. Conserva las reacciones por ID y tamaño, incluida la transición Secondary focus a hover del mismo tamaño.\n- Label editable; dos iconos opcionales independientes apagados por defecto. Usa la instancia remota PlusCircle Outline/Light y mantiene el swap y el color del vector por receta. Phosphor es la fuente autorizada. Loading sustituye iconos por [Loader](loader.contract.v1.0.0.md) con color y tamaño según receta. El set expone propiedades acotadas y no necesita Slot arbitrario.\n- Web usa botón nativo para acciones y enlace con href para navegación. La carga bloquea activaciones y anuncia `aria-busy`; la caja reserva el ancho normal durante la operación. Disabled bloquea la acción. El anfitrión explica el motivo, conecta la acción, gestiona confirmaciones y aporta el contexto de error. El ejemplo usa estado local.\n- El foco es visible en teclado y se conserva durante la interacción aplicable. Las alturas fuente se conservan. Una pantalla puede necesitar ampliar su área táctil según contexto. La geometría fuente no acredita conformidad WCAG.\n\n## Guía semántica normativa\n\nUsa primary para una única acción principal por vista o diálogo. Secondary acompaña una acción alternativa; text reduce jerarquía para una acción terciaria; link navega; danger reserva acciones destructivas que el anfitrión debe confirmar con objeto y consecuencia. Evita dos acciones primary que compitan. Mantén un tamaño coherente en el grupo.\n\nEl contenedor aporta el área de interacción y el foco, Label identifica el resultado, los iconos son opcionales y Loader indica actividad en curso. Usa un verbo en infinitivo y un objeto cuando aclare, con hasta tres palabras según la guía fuente. Para cargar, usa gerundio y elipsis. La posición de las acciones y el área táctil son responsabilidad de la pantalla.\n\nHaz «Guardar cambios» como primary, con una alternativa secondary como «Cancelar». Evita activar dos veces la misma acción mientras aparece «Guardando…». Usa link con una URL cuando el propósito sea navegar. Procedencia: descripción vigente de los cinco sets y reglas REQ-USAGE, REQ-CONTENT, REQ-LOADING y REQ-ACCESSIBILITY de BUTTON-001 v4.0.1 capturado.\n\n## Aceptación\n\nVerificar 90 combinaciones, propiedades, 150 instancias oficiales de icono, 15 composiciones loading, variables remapeadas, foco y reacciones por variante. Probar interacción web de forma independiente.\n\n## Implementación y QA\n\n[Estado e IDs en el maestro](../../implementations/figma/buttons-loader-2026-11-11/buttons.state.json) y [QA de Figma y web](../../qa/implementations/buttons-loader.v1.0.0.review.md). El recetario de consumo conserva los modos y la sintaxis WEB del inventario. Las magnitudes de la geometría y tipografía verificadas se convierten a px en el consumidor CSS. Manrope se entrega con el recurso variable local. El enlace del componente Figma remite a la documentación visible de su fuente. La ficha local queda identificada por contrato y se genera en el catálogo.\n"}, {"path": "specs/components/buttons.usage.amendment.v1.0.1.md", "sha256": "39c8b5851fd42cc0e57257faab9c7bdac4d529422eea58378bc81a06f70bded8", "text": "---\ncontract_schema: sdd-project/0.2\ncontract_id: BUTTON-001\namendment_id: BUTTON-USAGE-001\ntype: component-amendment\nversion: 1.0.1\nstatus: DELEGATED_FOR_BUILD\nbase_contract: specs/components/buttons.contract.v1.0.0.md\napplies_to: [BUTTON-001]\nuser_audit: NOT_REQUIRED\nhuman_review_policy: OPTIONAL_NON_BLOCKING\n---\n\n# Buttons · Guía de uso v1.0.1\n\nEsta enmienda amplía la guía de [Buttons v1.0.0](buttons.contract.v1.0.0.md#guía-semántica-normativa). La geometría, los bindings y la matriz de 90 variantes conservan su versión de implementación. El QA cubre texto, enlaces, ficha y preservación estructural.\n\n## Guía semántica normativa\n\nUsa Button cuando la persona decide iniciar una acción. El texto debe anticipar el resultado. Para elegir entre valores simultáneos, usa el control de selección que corresponda. Si la interacción cambia de destino, usa la variante Link y un enlace real.\n\n| Variante | Cuándo usar | Haz | Evita |\n|---|---|---|---|\n| Primary | Acción que completa el objetivo de la vista o diálogo. | «Guardar borrador» en un editor de reporte. | Dar la misma prominencia a «Guardar borrador» y «Cancelar». |\n| Secondary | Alternativa visible que acompaña la acción principal. | «Volver a edición» junto a «Guardar borrador». | Dar jerarquía secundaria a una acción que la persona necesita encontrar primero. |\n| Text | Acción terciaria, local y de menor énfasis. | «Restaurar filtros» al lado de los filtros aplicados. | Usarla para la acción principal de un formulario o para navegar a otra vista. |\n| Link | Navegación hacia una URL o destino concreto. | «Ver historial» con un href a la página de historial. | Usarlo para aprobar, guardar o eliminar un registro. |\n| Danger | Acción destructiva o irreversible. La pantalla aporta confirmación con objeto y consecuencia. | «Eliminar borrador» en el diálogo que identifica el borrador afectado. | Usarlo como acento para resaltar una acción cotidiana. |\n\n**Tamaño y composición.** Mantén un tamaño coherente en un grupo. Los tres tamaños conservan 48, 40 y 32 px de alto. El anfitrión decide el layout y comprueba el área táctil necesaria. Label aporta el nombre. Los iconos Phosphor son opcionales y se eligen por su contribución al significado. El foco exterior pertenece al control. La composición es acotada y P-SLOTS queda NOT_APPLICABLE.\n\n**Estados.** Default comunica disponibilidad. Hover y pressed dan respuesta temporal a puntero o activación. Focus conserva una señal visible al tabular. Loading señala una acción ya iniciada, conserva el ancho en web y reemplaza los iconos por el Loader compartido. Disabled impide iniciar una acción y la pantalla explica el requisito para habilitarla. Un error posterior pertenece al flujo que lanzó la acción.\n\n**Caso de carga.** Al activar «Guardar borrador» pasa a «Guardando…» y bloquea una segunda activación. La operación real pertenece al anfitrión. Cuando termina, la pantalla decide cómo comunicar el resultado y restablece la disponibilidad que corresponda. La demo del catálogo permite entrar y salir de carga mediante estado local.\n\n**Accesibilidad.** Usa botón nativo para una acción y enlace con href para navegación. Mantén un nombre específico, el foco visible, la activación por teclado y la comunicación de ocupado en web. Si la acción está deshabilitada, deja visible o accesible el motivo. El color y los iconos complementan la etiqueta.\n\n**Contraste editorial.** Atlassian y Carbon orientan la jerarquía de una acción principal, las alternativas y la claridad de etiquetas. La semántica, matriz y restricciones de BlueHeart siguen gobernadas por el contrato base. [Atlassian Button](https://atlassian.design/components/button/usage) · [Carbon Button](https://www.carbondesignsystem.com/building-blocks/core/components/button/guidelines)\n\n## Description exacta por set\n\n| Set | ID maestro | Description |\n|---|---|---|\n| Button/primary | 23:835 | BUTTON-001 · Uso v1.0.1. Usa Primary para la acción principal de una vista o diálogo, como «Guardar borrador». Evita dos acciones principales en el mismo grupo. Secondary acompaña alternativas y Link navega. Mantén el tamaño del grupo y un Label específico. Conserva el foco de teclado. Durante Loading, el Loader compartido indica «Guardando…» y el consumidor bloquea duplicados. Ficha local: Buttons / BUTTON-001. |\n| Button/secondary | 23:952 | BUTTON-001 · Uso v1.0.1. Usa Secondary para una alternativa a la acción principal, como «Volver a edición». Evita darle el mismo énfasis que a «Guardar borrador». Mantén el tamaño del grupo, Label específico y foco visible. Los iconos Phosphor son opcionales. Durante Loading, el consumidor bloquea otra activación. Ficha local: Buttons / BUTTON-001. |\n| Button/text | 23:1070 | BUTTON-001 · Uso v1.0.1. Usa Text para una acción local terciaria, como «Restaurar filtros». Elige Primary si la acción completa la tarea y Link si cambia de destino. Conserva Label explícito y foco visible. Loading usa el Loader compartido y comunica ocupado. Ficha local: Buttons / BUTTON-001. |\n| Button/link | 23:1185 | BUTTON-001 · Uso v1.0.1. Usa Link para navegar, como «Ver historial». El consumidor aporta un href y conserva el nombre y foco de teclado. Usa un botón de acción para guardar, confirmar o eliminar. Durante Loading o Disabled, el consumidor impide activar el destino. Ficha local: Buttons / BUTTON-001. |\n| Button/danger | 23:1306 | BUTTON-001 · Uso v1.0.1. Usa Danger para una acción destructiva, como «Eliminar borrador». La pantalla identifica el objeto, explica la consecuencia y solicita confirmación. Evita usarlo como énfasis decorativo. Conserva Label, foco y bloqueo de activaciones durante Loading. Ficha local: Buttons / BUTTON-001. |\n"}, {"path": "specs/components/loader.contract.v1.0.0.md", "sha256": "b6bc0b64db1ebaefef508c2070add1d0f312d2e5b4cc20960b7d859b6bed0d55", "text": "---\ncontract_schema: sdd-project/0.2\ncontract_id: LOADER-001\nname: Loader\ntype: component\nstatus: DELEGATED_FOR_BUILD\nversion: 1.0.0\nlast_updated: 2026-11-11\nfigma_page_name: Loader\ntarget_file_key: yZsIpXywybsPDytjolwcP4\nfigma_page_id: \"22:2\"\ntarget_node_ids: [\"23:74\", \"23:171\", \"23:268\", \"23:365\", \"23:462\", \"23:559\", \"23:680\"]\nslot_applicability: NOT_APPLICABLE\nreadiness_by_target: {figma: READY, web: READY}\nuser_audit: NOT_REQUIRED\nhuman_review_policy: OPTIONAL_NON_BLOCKING\nsource_data_ref: specs/data/loader.v1.0.0.json\nsource_data_digest_sha256: 09a7070ebb3dd5b583ce613e61a59c3b8321fd75060da671a13a1b429049abfe\ndata_refs:\n  - specs/data/loader.v1.0.0.json\n  - sources/figma-snapshots/buttons-loader-2026-11-11/manifest.json\ndependencies: ['FOUNDATIONS-BLUEHEART-VARIABLES-001']\n---\n\n# Loader · LOADER-001\n\nIngesta del [Figma raíz](../../sources/figma-snapshots/buttons-loader-2026-11-11/manifest.json) y recetario delegado de [bindings, geometría y reacciones](../data/loader.v1.0.0.json). La implementación usa el mapa verificado de [variables del maestro](../foundations/blueheart-variables.contract.v0.1.2.md). La captura registra versiones de origen y hashes. Construcción en la página Loader, reservada a los principales y sus variantes. P-SLOTS: `NOT_APPLICABLE` por composición acotada.\n\n## Cobertura y comportamiento\n\n- 24 variantes públicas, seis tamaños (16, 20, 24, 40, 64, 88 px) y cuatro roles cromáticos. Seis sets internos de 24 fases, con transición instantánea cada 0,033333335 s y vuelta nominal de 0,8 s. El riel y el arco son elipses nativas; el remate del arco es redondo. El riel on-color conserva opacidad 0,3. Son partes del indicador, no iconos.\n- El anfitrión controla cuándo mostrar la espera. La guía fuente recomienda aproximadamente 300 ms y un mensaje de proceso al superar 2 s. Si se conoce el avance en una espera prolongada, usar un indicador determinado.\n- Web usa SVG con los mismos roles y 24 pasos, 1,6 s para movimiento reducido. El anfitrión aporta mensaje accesible, con `role=status` y anuncio cortés. Dentro de Button, el indicador es decorativo y Button comunica que está ocupado.\n- Se verifican geometría, vínculos, color y topología almacenada. Las reacciones almacenadas no miden fps ni reproducción real.\n\n## Guía semántica normativa\n\nUsa Loader para espera de duración indeterminada. Ajusta el tamaño al contenedor y elige brand para la marca del tema, neutral o strong sobre superficies claras y on-color sobre fondo de color. Mantén el contenido anterior si solo se actualiza una parte. El riel da contexto al arco y el arco indica que la operación continúa. La composición es fija; el texto y su posición pertenecen al anfitrión. No recibe foco ni activa acciones.\n\nHaz que una espera prolongada vaya acompañada de «Cargando archivos…». Evita usar el indicador como único mensaje de error o elegir on-color sobre blanco. Procedencia: documentación del nodo fuente Loader y LOADER-001 v1.0.0 capturado.\n\n## Aceptación\n\nVerificar las 24 combinaciones, los 144 destinos y retornos, las elipses y sus aliases y los 15 vínculos desde Button. Verificar roles accesibles y el control de movimiento de web por separado.\n\n## Implementación y QA\n\n[Estado e IDs en el maestro](../../implementations/figma/buttons-loader-2026-11-11/loader.state.json) y [QA de Figma y web](../../qa/implementations/buttons-loader.v1.0.0.review.md). El recetario de consumo conserva los modos y la sintaxis WEB del inventario. Las magnitudes de la geometría y tipografía verificadas se convierten a px en el consumidor CSS. Manrope se entrega con el recurso variable local. El enlace del componente Figma remite a la documentación visible de su fuente. La ficha local queda identificada por contrato y se genera en el catálogo.\n"}, {"path": "specs/foundations/blueheart-variables.contract.v0.1.2.md", "sha256": "7179e6bb8d79a2b63f2f1b4d023528ea460def806a34e98f5ce53c110bbefce0", "text": "---\ncontract_schema: sdd-project/0.2\ncontract_id: FOUNDATIONS-BLUEHEART-VARIABLES-001\nname: Variables BlueHeart en tres colecciones\ntype: tokens\nstatus: DELEGATED_FOR_BUILD\nversion: 0.1.2\nlast_updated: 2026-11-11\nuser_audit: NOT_REQUIRED\nhuman_review_policy: OPTIONAL_NON_BLOCKING\nsource_data_ref: specs/tokens/blueheart-variables.v0.1.2.json\nsource_data_digest_sha256: 09a96d3707735fa129e3cfa99de6ccac1a9d94ccf5cc19fa5d282de867629993\ndata_refs:\n  - specs/tokens/visibility.body-only.correction.json\n  - specs/tokens/blueheart-variables.v0.1.2.json\n  - sources/figma-snapshots/variables-2026-11-11/capture-manifest.json\n---\n\n# Variables BlueHeart en tres colecciones\n\nLa organización vigente incorpora la corrección de colecciones y la nomenclatura de talla confirmada por el usuario. En el maestro quedan exactamente tres colecciones locales, con nombres `primitives`, `semantic` y `component`. Los 19 grupos usan nombres de variable con barra dentro de `primitives`, por ejemplo `orange/100` y `font-family/inter`. Conserva el orden de modos observado, los nombres y la estructura fuente de `semantic` y `component`.\n\n## Autoridad y datos\n\nLa [corrección de visibilidad de tokens](token-visibility.contract.v1.0.0.md) sustituye exclusivamente los scopes efectivos del inventario histórico. Solo `component/body/` se expone en selectores, con scopes específicos; las demás variables conservan su función con `[]`. Identidad, valores, aliases, bindings y publicación siguen intactos. El JSON histórico mantiene su hash y procedencia; consumir también la corrección delegada vigente.\n\nEl [JSON delegado](../tokens/blueheart-variables.v0.1.2.json) gobierna los datos y la descripción canónica de cada variable. La [captura y sus hashes](../../sources/figma-snapshots/variables-2026-11-11/capture-manifest.json) conservan los IDs y los valores de origen. Los IDs y keys reales del maestro se registran en una evidencia de implementación. El QA documental está en [el comprobante](../../qa/implementations/blueheart-variables.v0.1.2.review.md).\n\n## Mapa de grupos de primitivas\n\nUna colección, un modo `Value`, 173 variables.\n\n| Grupo | Variables | Muestra de nombres dentro del grupo |\n|---|---:|---|\n| `amber` | 9 | 500, 100, 600 |\n| `blue` | 9 | 500, 600, 700 |\n| `cyan` | 9 | 500, 100, 600 |\n| `emerald` | 9 | 400, 100, 600 |\n| `font-family` | 2 | manrope, inter |\n| `font-letter-spacing` | 7 | tight, normal, wide |\n| `font-line-height` | 11 | 16, 20, 24 |\n| `font-size` | 10 | 12, 14, 16 |\n| `font-weight` | 4 | semibold, regular, medium |\n| `green` | 9 | 100, 200, 300 |\n| `neutral` | 10 | 300, 600, 700 |\n| `orange` | 9 | 100, 200, 300 |\n| `purple` | 9 | 100, 200, 300 |\n| `radius` | 9 | 0, 32, 2 |\n| `red` | 9 | 500, 100, 600 |\n| `shadow` | 1 | md |\n| `size` | 25 | md, sm, lg |\n| `spacing` | 15 | 0, 56, 64 |\n| `stroke` | 7 | 0, 1, 2 |\n\n## Reconstrucción y recuperación\n\n1. Verificar que las colecciones adicionales y sus variables correspondan a los IDs creados durante el plan interrumpido. Conservar evidencia del estado intermedio.\n2. Crear `primitives` y sus 173 variables con ruta de grupo. Preservar valores, tipos, scopes, descripción, codeSyntax, visibilidad y modo fuente. Validar cada identidad antes de reorientar consumidores.\n3. Reorientar los 134 aliases semánticos a los nuevos IDs de `primitives`. Conservar el mismo ID real de cada semántica existente. Los 3.520 aliases de componente apuntan a esas mismas semánticas. Completar las 355 variables de componente faltantes según la lectura intermedia.\n4. Comprobar que ningún consumidor local conserve un alias hacia las 19 colecciones que se retiran. Retirar solo colecciones creadas por este encargo e identificadas por IDs y keys en los recibos. Releer la cobertura total y campos del resultado.\n5. Mantener intacta la raíz. No crear nodos de lienzo ni publicar. QA visual del usuario es opcional después de la verificación técnica.\n\n## Guía semántica normativa\n\nConsume el rol de componente establecido por la spec de familia. El token de componente enlaza con el rol semántico. Las primitivas proveen los valores de las escalas y medidas observadas. Evita seleccionar una primitiva por similitud de valor. Conserva aliases y modos. Los grupos expresan identidad y categoría. Un nombre de medida no establece una unidad. Estados, decisiones de uso, contenido, composición visual, Slots y accesibilidad se especifican con evidencia por familia. Las 23 descripciones vacías se conservan.\n\n**Haz.** Usa la referencia real a `primitives` y su nombre de ruta en el alias Figma. **Evita.** Crear una colección por cada paleta, completar niveles ausentes o cambiar un alias a literal.\n\n\n## Nomenclatura de talla dentro de size\n\nEn `primitives`, el grupo `size` adopta las equivalencias verificadas en los aliases semánticos de origen. El patrón conserva magnitud, tipo, ID y sintaxis WEB.\n\n| Valor | Ruta final |\n|---:|---|\n| 4 | `size/xs` |\n| 8 | `size/sm` |\n| 12 | `size/md` |\n| 16 | `size/lg` |\n| 20 | `size/xl` |\n| 24 | `size/2xl` |\n| 32 | `size/3xl` |\n| 40 | `size/4xl` |\n| 48 | `size/5xl` |\n| 56 | `size/6xl` |\n| 64 | `size/7xl` |\n| 88 | `size/8xl` |\n\nConservan sufijo numérico 6, 18, 72, 104, 120, 200, 234, 240, 294, 320, 358, 554 y 1152. El grupo `font-size` conserva nombres de origen agrupados.\n\n## Estado de implementación\n\n`VALIDATED` para variables del maestro. [Mapa de IDs](../../implementations/figma/variables-2026-11-11/id-map.json) y [readback final](../../implementations/figma/variables-2026-11-11/final-collections.readback.json). La publicación remota sigue en HOLD. Este alcance no establece conversiones CSS ni reglas visuales de familias.\n\nLa [corrección de bindings de componente](../tokens/component-layer.correction.json) aporta los aliases delegados para App Shell, Conversation Composer, Conversation Response y Stepper en las versiones vigentes.\n"}, {"path": "specs/data/buttons.v1.0.0.json", "sha256": "d271e1de91be664fe0c78eef8ea311fdafa52073535f4349a7d78f7611d4c9fa", "text": ""}, {"path": "specs/tokens/blueheart-variables.v0.1.2.json", "sha256": "09a96d3707735fa129e3cfa99de6ccac1a9d94ccf5cc19fa5d282de867629993", "text": ""}, {"path": "specs/tokens/component-layer.correction.json", "sha256": "3bbdc83a5e69674c68e33febc75187c3cffad4498586eeabce5d8bcd3c190c2a", "text": ""}, {"path": "specs/tokens/visibility.body-only.correction.json", "sha256": "bfeff78297e413e05a989523fecf5adb8f79850f99cd15cd25196a78b2e88397", "text": ""}], "tokens": [{"id": "specs/tokens/blueheart-variables.v0.1.2.json#/collections/2/variables/113", "source": "specs/tokens/blueheart-variables.v0.1.2.json", "location": "JSON:/collections/2/variables/113", "evidence": "EXTRACTED", "confidence": 1, "value": {"id": "VariableID:11:91", "key": "bd79c13e4e51b0cf48505cb173d8ac40d193a529", "name": "button/font/family", "variableCollectionId": "VariableCollectionId:11:2", "description": "Button: token compartido por propiedad y aliases idénticos en los cuatro temas. Estados y variantes se resuelven en la receta, sin duplicar variables.", "resolvedType": "STRING", "scopes": ["FONT_FAMILY"], "codeSyntax": {"WEB": "var(--font-button-label-family)"}, "hiddenFromPublishing": false, "remote": false, "valuesByMode": {"11:0": {"type": "VARIABLE_ALIAS", "id": "VariableID:6:194"}, "11:1": {"type": "VARIABLE_ALIAS", "id": "VariableID:6:194"}, "11:2": {"type": "VARIABLE_ALIAS", "id": "VariableID:6:194"}, "11:3": {"type": "VARIABLE_ALIAS", "id": "VariableID:6:194"}}, "sourceName": "button/font/family"}}], "metrics": {"files_read": 8, "bytes_read": 1588373, "index_bytes": 382582, "nodes_visited": 8, "duration_ms": 1248.263, "context_bytes": 27011}, "coverage": "DIRECT_REFERENCES"}
