letterSpacing\": {\n        \"unit\": \"PIXELS\",\n        \"value\": 0\n      },\n      \"textDecoration\": \"NONE\",\n      \"textCase\": \"ORIGINAL\",\n      \"paragraphIndent\": 0,\n      \"paragraphSpacing\": 0,\n      \"b\": {\n        \"letterSpacing\": \"VariableID:443:13\",\n        \"fontSize\": \"VariableID:443:11\",\n        \"fontStyle\": \"VariableID:443:10\",\n        \"fontFamily\": \"VariableID:443:9\",\n        \"lineHeight\": \"VariableID:443:12\"\n      }\n    }\n  },\n  \"tokens\": {\n    \"VariableID:443:15\": {\n      \"name\": \"linear-progress/radius/track\",\n      \"targetId\": \"VariableID:8:693\",\n      \"css\": \"--linear-progress-radius-track\",\n      \"type\": \"FLOAT\"\n    },\n    \"VariableID:443:17\": {\n      \"name\": \"linear-progress/color/indicator/primary\",\n      \"targetId\": \"VariableID:8:695\",\n      \"css\": \"--linear-progress-color-indicator-primary\",\n      \"type\": \"COLOR\"\n    },\n    \"VariableID:443:23\": {\n      \"name\": \"linear-progress/color/indicator/success\",\n      \"targetId\": \"VariableID:8:701\",\n      \"css\": \"--linear-progress-color-indicator-success\",\n      \"type\": \"COLOR\"\n    },\n    \"VariableID:443:24\": {\n      \"name\": \"linear-progress/color/indicator/warning\",\n      \"targetId\": \"VariableID:8:702\",\n      \"css\": \"--linear-progress-color-indicator-warning\",\n      \"type\": \"COLOR\"\n    },\n    \"VariableID:443:25\": {\n      \"name\": \"linear-progress/color/indicator/error\",\n      \"targetId\": \"VariableID:8:703\",\n      \"css\": \"--linear-progress-color-indicator-error\",\n      \"type\": \"COLOR\"\n    },\n    \"VariableID:443:5\": {\n      \"name\": \"linear-progress/spacing/content\",\n      \"targetId\": \"VariableID:8:683\",\n      \"css\": \"--linear-progress-spacing-content\",\n      \"type\": \"FLOAT\"\n    },\n    \"VariableID:443:4\": {\n      \"name\": \"linear-progress/spacing/none\",\n      \"targetId\": \"VariableID:8:682\",\n      \"css\": \"--linear-progress-spacing-none\",\n      \"type\": \"FLOAT\"\n    },\n    \"VariableID:443:6\": {\n      \"name\": \"linear-progress/size/min-width\",\n      \"targetId\": \"VariableID:8:684\",\n      \"css\": \"--linear-progress-size-min-width\",\n      \"type\": \"FLOAT\"\n    },\n    \"VariableID:443:7\": {\n      \"name\": \"linear-progress/spacing/header\",\n      \"targetId\": \"VariableID:8:685\",\n      \"css\": \"--linear-progress-spacing-header\",\n      \"type\": \"FLOAT\"\n    },\n    \"VariableID:443:8\": {\n      \"name\": \"linear-progress/color/text/default\",\n      \"targetId\": \"VariableID:8:686\",\n      \"css\": \"--linear-progress-color-text-default\",\n      \"type\": \"COLOR\"\n    },\n    \"VariableID:443:13\": {\n      \"name\": \"linear-progress/font/letter-spacing\",\n      \"targetId\": \"VariableID:8:691\",\n      \"css\": \"--linear-progress-font-letter-spacing\",\n      \"type\": \"FLOAT\"\n    },\n    \"VariableID:443:19\": {\n      \"name\": \"linear-progress/font/size-14\",\n      \"targetId\": \"VariableID:8:697\",\n      \"css\": \"--linear-progress-font-size-14\",\n      \"type\": \"FLOAT\"\n    },\n    \"VariableID:443:10\": {\n      \"name\": \"linear-progress/font/style\",\n      \"targetId\": \"VariableID:8:688\",\n      \"css\": \"--linear-progress-font-style\",\n      \"type\": \"STRING\"\n    },\n    \"VariableID:443:9\": {\n      \"name\": \"linear-progress/font/family\",\n      \"targetId\": \"VariableID:8:687\",\n      \"css\": \"--linear-progress-font-family\",\n      \"type\": \"STRING\"\n    },\n    \"VariableID:443:20\": {\n      \"name\": \"linear-progress/font/line-height-20\",\n      \"targetId\": \"VariableID:8:698\",\n      \"css\": \"--linear-progress-font-line-height-20\",\n      \"type\": \"FLOAT\"\n    },\n    \"VariableID:443:22\": {\n      \"name\": \"linear-progress/size/height-large\",\n      \"targetId\": \"VariableID:8:700\",\n      \"css\": \"--linear-progress-size-height-large\",\n      \"ty